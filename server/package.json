{
  "name": "whatsapp-business-manager-server",
  "version": "1.0.0",
  "description": "Backend API for WhatsApp Business Manager",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node prisma/seed.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "@prisma/client": true
  },
  "dependencies": {
    "@prisma/client": "5.7.1",
    "bcryptjs": "2.4.3",
    "cloudinary": "1.41.3",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "express-validator": "7.0.1",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "multer-storage-cloudinary": "4.0.0"
  },
  "devDependencies": {
    "nodemon": "3.0.2",
    "prisma": "5.7.1"
  }
}
