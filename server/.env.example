# Database — Railway volume path in production
DATABASE_URL="file:./prisma/dev.db"

# Server
PORT=3001

# URL of your Railway client service (for CORS)
CLIENT_URL=https://your-client.up.railway.app

# Auth
JWT_SECRET=your-very-long-random-secret-key-here
# Generate password hash: node -e "const b=require('bcryptjs');console.log(b.hashSync('yourpassword',10))"
OPERATOR_PASSWORD_HASH=

# Cloudinary — get from cloudinary.com free account
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
