{
  "name": "whatsapp-business-manager",
  "version": "1.0.0",
  "description": "WhatsApp Small Business Manager - ladies accessories shop management",
  "private": true,
  "scripts": {
    "dev": "concurrently \"cd server && npm run dev\" \"cd client && npm run dev\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "seed": "cd server && npm run seed",
    "db:migrate": "cd server && npm run db:migrate",
    "db:generate": "cd server && npm run db:generate"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "allowScripts": {
    "prisma@5.7.1": true,
    "@prisma/engines@5.7.1": true,
    "@prisma/client@5.7.1": true,
    "core-js@3.51.0": true,
    "esbuild@0.19.12": true
  }
}
